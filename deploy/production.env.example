# Copie para deploy/production.env, restrinja com chmod 600 e substitua todos os valores.
# O arquivo real e os backups nunca devem ser versionados.

# Porta publicada somente no loopback da VPS; o Nginx fará o proxy reverso.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8031

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_LONGA
DJANGO_ALLOWED_HOSTS=projeto-integrador.tesseratointegra.com.br,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://projeto-integrador.tesseratointegra.com.br
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_HSTS_SECONDS=31536000

# PostgreSQL. Se a senha contiver caracteres reservados de URL, codifique-os em DATABASE_URL.
POSTGRES_DB=codigo_futuro
POSTGRES_USER=codigo_futuro
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
DATABASE_URL=postgresql://codigo_futuro:SUBSTITUA_POR_UMA_SENHA_FORTE@database:5432/codigo_futuro

# Inicialização do container
WAIT_FOR_DATABASE=true
RUN_MIGRATIONS=true
COLLECT_STATIC=true
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_BIND=0.0.0.0:8000
FORWARDED_ALLOW_IPS=*

# Homologação acadêmica. Use uma senha exclusiva e remova a variável ao encerrar a avaliação.
DEMO_PASSWORD=SUBSTITUA_POR_UMA_SENHA_EXCLUSIVA_DE_AVALIACAO

# Em homologação, o backend de console evita dependência externa. Para recuperação real de senha,
# configure SMTP e altere EMAIL_BACKEND para django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@codigodofuturo.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
